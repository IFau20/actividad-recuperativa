# Backend only. Select the TEST environment in Mercado Pago Developers.
# Current Checkout Pro test-seller tokens may start with APP_USR-.
# The backend verifies that APP_USR tokens belong to a test user before checkout.
MP_ACCESS_TOKEN=
# Public HTTPS origin, without a trailing path. Never localhost for return URLs.
# Example: https://actividad-recuperativa.vercel.app
APP_BASE_URL=
PORT=3000
